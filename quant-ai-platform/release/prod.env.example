# Production release profile template.
# Replace every CHANGE_ME value through deployment secrets/config management.
COMPOSE_PROFILES=observability
SPRING_PROFILES_ACTIVE=docker
QUANT_AI_PROFILE=docker
QUANT_SECURITY_AUTH_MODE=DEMO
QUANT_SERVICE_ACTOR_SECRET=CHANGE_ME_STRONG_SERVICE_ACTOR_SECRET
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=quant_ai
MYSQL_USER=quant
MYSQL_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PHASE017_BASE_URL=https://CHANGE_ME_GATEWAY_HOST

# Security gate: DEMO auth is accepted only for local/demo release.
# Internet-facing production must first replace DEMO mode with governed gateway/JWT/IdP validation.
