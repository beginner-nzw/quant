{
  "name": "quant-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "e2e": "node scripts/e2e-smoke-check.mjs",
    "e2e:phase017": "powershell -ExecutionPolicy Bypass -File ../quant-ai-platform/test-harness/run-phase017-e2e.ps1",
    "load:phase017": "powershell -ExecutionPolicy Bypass -File ../quant-ai-platform/test-harness/run-phase017-load.ps1",
    "failure:phase017": "powershell -ExecutionPolicy Bypass -File ../quant-ai-platform/test-harness/run-phase017-failure-recovery.ps1",
    "test:phase017": "npm run e2e && npm run e2e:phase017 && npm run load:phase017 && npm run failure:phase017",
    "check:authority-boundary": "node scripts/authority-boundary-check.mjs",
    "check:frontend-production-workflow": "node scripts/frontend-production-workflow-check.mjs",
    "check:market-data-ingest": "node scripts/market-data-ingest-contract-check.mjs",
    "check:report-contract": "node scripts/report-contract-check.mjs",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dayjs": "^1.11.20",
    "element-plus": "^2.13.5",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
